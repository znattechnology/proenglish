# =============================================================================
# ENVIRONMENT VARIABLES - EXEMPLO
# =============================================================================

# Copie este arquivo para .env e configure suas chaves reais

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
USE_POSTGRESQL=False

DATABASE_URL='postgresql://UTILIZADOR:PALAVRA_PASSE@HOST:5432/BASE'

# PostgreSQL local em Docker: docker compose -f docker-compose.dev.yml up -d
# DATABASE_URL=postgresql://proenglish:proenglish@localhost:5435/proenglish_dev
# Alternativa sem DATABASE_URL (descomente e configure):
# USE_POSTGRESQL=True
# DB_NAME=your-neon-database-name
# DB_USER=your-neon-username
# DB_PASSWORD=your-neon-password
# DB_HOST=your-project-name.neon.tech
# DB_PORT=5432

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI API Configuration (OBRIGATÓRIO PARA SPEAKING PRACTICE)
OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENAI_ORGANIZATION_ID=org-your-org-id-here-optional

# Fase 3 (medir a fala): fala -> texto, análise de pronúncia e avaliação detalhada (opcional)
TRANSCRICAO_FALA_PROVEDOR=openai
TRANSCRICAO_FALA_MODELO=whisper-1
PRONUNCIA_CLAUDE_MODELO=claude-haiku-5-5
# auto = Azure Speech quando a chave e a região estão definidas (limite diário por plano); texto = desligado
PRONUNCIA_PROVEDOR=auto
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Opcional: https://<recurso>.cognitiveservices.azure.com (vazio usa a região)
AZURE_SPEECH_ENDPOINT=

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email Settings (opcional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True

# AWS S3 Settings (opcional)
USE_S3=False
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# Cloudflare R2 (compatível com S3): com estas duas, os ficheiros vão para o R2.
# AWS_S3_ENDPOINT_URL=https://<id da conta>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.<domínio> (ou pub-….r2.dev, só para testes)

# Google OAuth (opcional)
# GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id
# GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# VAPI INTEGRATION SETTINGS (Para Prática de Fala com IA)
# =============================================================================

# Vapi API Keys (obtenha em https://vapi.ai/dashboard)
VAPI_PRIVATE_KEY=your-vapi-private-key-here
VAPI_PUBLIC_KEY=your-vapi-public-key-here
VAPI_ORG_ID=your-vapi-org-id-here

# Vapi Configuration
VAPI_BASE_URL=https://api.vapi.ai
VAPI_WEBHOOK_SECRET=your-webhook-secret-here

# Webhook URLs para Vapi (ajustar conforme deploy)
VAPI_WEBHOOK_URL=http://localhost:8000/api/v1/practice/vapi/webhook/
BACKEND_BASE_URL=http://localhost:8000

# Vapi Voice Settings (opcional)
VAPI_DEFAULT_VOICE=alloy
VAPI_TTS_PROVIDER=openai
VAPI_STT_PROVIDER=openai
# Web Push (avisos do aluno). Gerar: ./venv/bin/python manage.py gerar_chaves_vapid
# Sem estas chaves o push fica desligado (os avisos in-app continuam).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=suporte@proenglish.ao

# =============================================================================
# CACHE, LIMITES DE PEDIDOS E PROXY
# =============================================================================
# Cache partilhada (limites de pedidos por IP/utilizador contam em todos os workers).
# Sem REDIS_URL usa memória por processo (só para desenvolvimento).
# REDIS_URL=redis://localhost:6379/1
# CACHE_KEY_PREFIX=proenglish

# Ligar SÓ quando a API está atrás de um proxy (nginx) que grava X-Real-IP/X-Forwarded-For.
# Sem proxy, o cliente podia inventar o IP e fugir aos limites.
TRUSTED_PROXY=False
# Número de proxies à frente da API (conta a partir do fim de X-Forwarded-For).
TRUSTED_PROXY_COUNT=1

# Origens aceites para pedidos que alteram dados com o cookie de sessão (defesa CSRF).
# Vazio = CORS_ALLOWED_ORIGINS + CSRF_TRUSTED_ORIGINS + FRONTEND_URL.
# COOKIE_AUTH_ALLOWED_ORIGINS=https://proenglish.ao,https://www.proenglish.ao

# Email de apoio mostrado nos emails aos alunos
SUPPORT_EMAIL=suporte@proenglish.ao
