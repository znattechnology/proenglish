# Copiar para .env nesta pasta (/opt/proenglish/app/apps/api/deploy/vps/.env), com chmod 600.
# O DATABASE_URL não se define aqui: o docker-compose.yml monta-o a partir de POSTGRES_PASSWORD.
# API_IMAGE é escrita pelo deploy.sh (a imagem em uso): não editar.
# O deploy.sh recusa avançar sem as obrigatórias (marcadas com *).

# ── Base de dados ──────────────────────────────────────────────────────────
# * Gerar com: openssl rand -hex 24   (só letras e números: entra num URL sem escapes)
POSTGRES_PASSWORD=

# ── Django ─────────────────────────────────────────────────────────────────
# * Gerar com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Endereço provisório (sslip.io) até haver domínio: juntar o domínio novo quando existir.
# proenglish-api: a web chama a API pela rede interna do Caddy (DJANGO_API_URL_INTERNA).
ALLOWED_HOSTS=proenglish-api.2.31.122.170.sslip.io,proenglish-api,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://proenglish.2.31.122.170.sslip.io
CSRF_TRUSTED_ORIGINS=https://proenglish.2.31.122.170.sslip.io
FRONTEND_URL=https://proenglish.2.31.122.170.sslip.io
BACKEND_BASE_URL=https://proenglish-api.2.31.122.170.sslip.io
# * Atrás do Caddy: IP real dos alunos (limites de pedidos) e HTTPS reconhecido.
TRUSTED_PROXY=True
TRUSTED_PROXY_COUNT=1
# Web (Vercel) e API em domínios diferentes: cookies entre sites.
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None

# ── Pagamentos (Multicaixa Express) ────────────────────────────────────────
# Sem acordo com a EMIS só existe o provedor simulado. True = qualquer pessoa activa planos
# sem pagar (útil numa fase de testes fechada); False = a criação de pagamentos devolve 503.
PAGAMENTOS_PROVEDOR=simulado
PAGAMENTOS_SIMULADOS=False

# ── IA ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Pronúncia detalhada (Azure Speech). Sem chave, a pronúncia é avaliada só pelo texto.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Pronúncia no exame oral pela gravação consentida (precisa do Azure).
PRONUNCIA_EXAME=True

# ── Conversa por voz (Vapi) ────────────────────────────────────────────────
VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=
VAPI_ORG_ID=
VAPI_ENGLISH_ASSISTANT_ID=
# Obrigatório com o Vapi ligado: o mesmo segredo configurado no servidor do assistente no Vapi.
VAPI_WEBHOOK_SECRET=
VAPI_WEBHOOK_URL=https://proenglish-api.2.31.122.170.sslip.io/api/v1/practice/vapi/webhook/

# ── Login com Google ───────────────────────────────────────────────────────
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
GOOGLE_OAUTH2_REDIRECT_URI=https://proenglish.ao/auth/google/callback
# IDs de cliente da app móvel (Android e iOS), separados por vírgulas.
GOOGLE_OAUTH2_CLIENT_IDS_APP=

# ── Email ──────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ── Notificações push no browser (gerar com: manage.py gerar_chaves_vapid) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

# ── Ficheiros enviados pelos utilizadores ──────────────────────────────────
# False: ficam no volume "media" do servidor (NÃO entra na cópia diária).
# True: S3 ou compatível (p.ex. o R2) com as chaves AWS_*.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION_NAME=

# ── Cópias da base no Cloudflare R2 (copia-bd.sh) ──────────────────────────
# Token de API do R2 com "Object Read & Write" limitado a este bucket.
R2_ACCOUNT_ID=fc0cfcd5098d0414eee8b09f4602ea3d
R2_BUCKET=proenglish-copias
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
