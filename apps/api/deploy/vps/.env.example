# Copiar para .env nesta pasta (/opt/proenglish/app/apps/api/deploy/vps/.env), com chmod 600.
# O DATABASE_URL não se define aqui: o docker-compose.yml monta-o a partir de POSTGRES_PASSWORD.

# ── Base de dados ──────────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 24   (só letras e números: entra num URL sem escapes)
POSTGRES_PASSWORD=

# ── Django ─────────────────────────────────────────────────────────────────
SECRET_KEY=
ALLOWED_HOSTS=api.proenglish.cloud,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://proenglish.cloud,https://www.proenglish.cloud
FRONTEND_URL=https://proenglish.cloud
BACKEND_BASE_URL=https://api.proenglish.cloud

# ── Cópias da base no Cloudflare R2 (copia-bd.sh) ──────────────────────────
# Token de API do R2 com "Object Read & Write" limitado a este bucket.
R2_ACCOUNT_ID=fc0cfcd5098d0414eee8b09f4602ea3d
R2_BUCKET=proenglish-copias
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Restantes variáveis ────────────────────────────────────────────────────
# Copiar do .env de produção actual: OPENAI_*, EMAIL_*, USE_S3 e AWS_*, GOOGLE_OAUTH2_*, VAPI_*.
# Ver ../../.env.production.example para a lista completa.
