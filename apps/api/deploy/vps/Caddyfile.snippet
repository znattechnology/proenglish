# ── ProEnglish API (/opt/proenglish/app/apps/api/deploy/vps) ────────────────
# Acrescentar UMA VEZ a /opt/proxy/caddy/Caddyfile (o Caddy é partilhado: o deploy automático
# nunca lhe toca). Fazer antes uma cópia e, em /opt/proxy:
#   cp caddy/Caddyfile caddy/Caddyfile.bak-$(date +%F)
#   docker compose exec caddy caddy validate --config /etc/caddy/Caddyfile
#   docker compose exec caddy caddy reload   --config /etc/caddy/Caddyfile
# Domínio: api.proenglish.ao (DNS na Angoweb, registo A para o servidor), desde 18/11/2026.
# O endereço sslip.io fica como alternativa. Um nome novo junta-se a esta linha, a ALLOWED_HOSTS no
# .env e, se passar a ser o principal, à variável API_URL do repositório no GitHub.
api.proenglish.ao, proenglish-api.2.31.122.170.sslip.io {
	encode zstd gzip

	# Vídeos e gravações das aulas chegam a dezenas de MB.
	request_body {
		max_size 100MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy proenglish-api:8000 {
		# A API (TRUSTED_PROXY=True) lê o IP do aluno daqui para os limites de pedidos.
		# O Caddy substitui o que o cliente mandar, para ninguém o inventar.
		header_up X-Real-IP {remote_host}
		# X-Forwarded-Proto/For/Host já são enviados pelo Caddy.
	}
}

# ── ProEnglish web (Next.js, mesmo projecto compose) ───────────────────────
# Domínio: proenglish.ao; o www redirecciona para ele (bloco no fim) (WEB_URL no GitHub; a web guarda o endereço dentro
# da imagem, por isso mudar de endereço pede uma nova publicação da web).
proenglish.ao, proenglish.2.31.122.170.sslip.io {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy proenglish-web:3000 {
		header_up X-Real-IP {remote_host}
	}
}

# www vai sempre para o domínio principal (sessão e entrada com o Google num só endereço).
www.proenglish.ao {
	redir https://proenglish.ao{uri} permanent
}
