{
  "expo": {
    "name": "ProEnglish",
    "slug": "proenglish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "proenglish",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "ios": {
      "bundleIdentifier": "ao.proenglish.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O ProEnglish usa o microfone para ouvir as suas respostas em inglês nas lições, na revisão e na conversa com o tutor.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "ao.proenglish.app",
      "adaptiveIcon": {
        "backgroundColor": "#000066",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withContaAppleGratuita",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000066",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "O ProEnglish usa o microfone para ouvir as suas respostas em inglês nas lições, na revisão e na conversa com o tutor."
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#000066"
        }
      ],
      "expo-sharing",
      "expo-font",
      "./plugins/withChamadaVoz",
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "http://localhost:8000/api/v1",
      "siteUrl": "http://localhost:3000",
      "eas": {
        "projectId": "a84bc1ec-c4bc-450d-a138-45100c970dc8"
      }
    },
    "experiments": {
      "reactCompiler": true
    },
    "owner": "vadaos-team"
  }
}
