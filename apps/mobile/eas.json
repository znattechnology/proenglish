{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "teste": {
      "distribution": "internal",
      "channel": "teste",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.proenglish.ao/api/v1",
        "EXPO_PUBLIC_SITE_URL": "https://proenglish.ao"
      }
    },
    "producao": {
      "channel": "producao",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.proenglish.ao/api/v1",
        "EXPO_PUBLIC_SITE_URL": "https://proenglish.ao"
      }
    }
  }
}
